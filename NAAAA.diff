@@ -0,0 +1,145 @@
+// SPDX-License-Identifier: GPL-3.0-only
+package helium314.keyboard.latin.voice
+
+import android.content.Context
+import android.graphics.Color
+import android.graphics.drawable.Drawable
+import android.graphics.drawable.GradientDrawable
+import android.text.TextUtils
+import android.view.Gravity
+import android.view.ViewGroup
+import android.widget.FrameLayout
+import android.widget.ImageButton
+import android.widget.ImageView
+import android.widget.LinearLayout
+import android.widget.TextView
+import androidx.core.content.ContextCompat
+import androidx.core.graphics.ColorUtils
+import helium314.keyboard.latin.R
+import helium314.keyboard.latin.common.ColorType
+import helium314.keyboard.latin.settings.Settings
+import helium314.keyboard.latin.utils.dpToPx
+
+/**
+ * Voice input panel that is drawn over the keyboard: status / live text, animated bars and one big
+ * mic / stop button. All colors come from the current keyboard theme.
+ */
+class VoiceInputView(context: Context, private val callback: Callback) : FrameLayout(context) {
+    interface Callback {
+        fun onCloseClicked()
+        fun onMicClicked()
+    }
+
+    private val wave = VoiceWaveView(context)
+    private val status = TextView(context)
+    private val micButton = ImageButton(context)
+    private val closeButton = ImageButton(context)
+    private var textColor = Color.WHITE
+    private var backgroundColorOpaque = Color.BLACK
+    private var listening = false
+
+    init {
+        isClickable = true // swallow touches, so nothing reaches the keyboard below
+
+        val column = LinearLayout(context)
+        column.orientation = LinearLayout.VERTICAL
+        column.gravity = Gravity.CENTER
+
+        status.gravity = Gravity.CENTER
+        status.textSize = 18f
+        status.typeface = android.graphics.Typeface.create(android.graphics.Typeface.DEFAULT, android.graphics.Typeface.BOLD)
+        status.minLines = 2
+        status.maxLines = 2
+        status.ellipsize = TextUtils.TruncateAt.START
+        val statusParams = LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT)
+        statusParams.marginStart = dp(56)
+        statusParams.marginEnd = dp(56)
+        column.addView(status, statusParams)
+
+        val waveParams = LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, dp(36))
+        waveParams.topMargin = dp(4)
+        waveParams.marginStart = dp(32)
+        waveParams.marginEnd = dp(32)
+        column.addView(wave, waveParams)
+
+        micButton.scaleType = ImageView.ScaleType.CENTER
+        micButton.setOnClickListener { callback.onMicClicked() }
+        val micParams = LinearLayout.LayoutParams(dp(64), dp(64))
+        micParams.topMargin = dp(8)
+        column.addView(micButton, micParams)
+
+        addView(column, FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT))
+
+        closeButton.scaleType = ImageView.ScaleType.CENTER
+        closeButton.contentDescription = context.getString(R.string.voice_close)
+        closeButton.setOnClickListener { callback.onCloseClicked() }
+        val closeParams = FrameLayout.LayoutParams(dp(48), dp(48), Gravity.TOP or Gravity.END)
+        closeParams.setMargins(dp(4), dp(4), dp(4), dp(4))
+        addView(closeButton, closeParams)
+
+        applyTheme(false)
+        setListening(false)
+    }
+
+    private fun dp(value: Int) = value.dpToPx(resources)
+
+    /**
+     * @param blurActive true if the system blurs what is behind the keyboard, so the panel can be translucent
+     * @param blurredImage blurred copy of the keyboard background image (custom background), if the theme has one
+     */
+    fun applyTheme(blurActive: Boolean, blurredImage: Drawable? = null) {
+        val colors = Settings.getValues().mColors
+        backgroundColorOpaque = ColorUtils.setAlphaComponent(colors.get(ColorType.MAIN_BACKGROUND), 255)
+        textColor = ColorUtils.setAlphaComponent(colors.get(ColorType.KEY_TEXT), 255)
+        if (blurredImage != null) background = blurredImage
+        else setBackgroundColor(if (blurActive) ColorUtils.setAlphaComponent(backgroundColorOpaque, 0xB0) else backgroundColorOpaque)
+        status.setTextColor(textColor)
+        wave.setColor(textColor)
+        val circle = GradientDrawable()
+        circle.shape = GradientDrawable.OVAL
+        circle.setColor(textColor)
+        circle.setStroke(dp(5), ColorUtils.setAlphaComponent(textColor, 0x44)) // soft ring around the button
+        micButton.background = circle
+        micButton.elevation = dp(4).toFloat()
+        val closeIcon = ContextCompat.getDrawable(context, R.drawable.ic_tb_close)?.mutate()
+        closeIcon?.setTint(textColor)
+        closeButton.setImageDrawable(closeIcon)
+        val closeBg = GradientDrawable()
+        closeBg.shape = GradientDrawable.OVAL
+        closeBg.setColor(ColorUtils.setAlphaComponent(textColor, 0x22))
+        closeButton.background = closeBg
+        updateMicIcon()
+    }
+
+    private fun updateMicIcon() {
+        val icon = ContextCompat.getDrawable(context, if (listening) R.drawable.ic_tb_stop else R.drawable.ic_tb_voice)?.mutate()
+        icon?.setTint(backgroundColorOpaque) // inverse of the button color
+        micButton.setImageDrawable(icon)
+        micButton.contentDescription = context.getString(if (listening) R.string.voice_stop else R.string.voice_start)
+    }
+
+    fun setListening(isListening: Boolean) {
+        listening = isListening
+        wave.setListening(isListening)
+        if (!isListening) {
+            micButton.scaleX = 1f
+            micButton.scaleY = 1f
+        }
+        updateMicIcon()
+    }
+
+    fun setStatusText(text: CharSequence) {
+        status.text = text
+    }
+
+    /** @param rmsDb value from RecognitionListener.onRmsChanged (roughly -2 to 10) */
+    fun setLevel(rmsDb: Float) {
+        val level = ((rmsDb + 2f) / 12f).coerceIn(0f, 1f)
+        wave.setLevel(level)
+        if (listening) {
+            val scale = 1f + 0.12f * level
+            micButton.scaleX = scale
+            micButton.scaleY = scale
+        }
+    }
+}
