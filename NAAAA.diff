+// SPDX-License-Identifier: GPL-3.0-only
+package helium314.keyboard.latin.utils
+
+import android.graphics.Bitmap
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.graphics.Rect
+import android.os.Build
+import kotlin.math.max
+
+/** Makes a blurred, slightly tinted copy of the keyboard background image, used behind emoji, clipboard and voice panels. */
+object BackgroundBlur {
+    private val TAG = BackgroundBlur::class.java.simpleName
+    private const val DOWNSCALE = 8 // blurring a small copy is fast, and stretching it back up is smooth by itself
+    private const val RADIUS = 3 // relative to the small copy
+    private const val TINT_ALPHA = 90
+
+    /** @return a small blurred bitmap that is meant to be stretched to the size of the view, or null if something went wrong */
+    fun blur(source: Bitmap, tint: Int): Bitmap? {
+        try {
+            var readable: Bitmap? = source
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O && source.config == Bitmap.Config.HARDWARE)
+                readable = source.copy(Bitmap.Config.ARGB_8888, false)
+            if (readable == null || readable.width < 1 || readable.height < 1) return null
+            val width = max(1, readable.width / DOWNSCALE)
+            val height = max(1, readable.height / DOWNSCALE)
+            val small = Bitmap.createBitmap(width, height, Bitmap.Config.ARGB_8888)
+            val canvas = Canvas(small)
+            canvas.drawBitmap(readable, null, Rect(0, 0, width, height), Paint(Paint.FILTER_BITMAP_FLAG))
+            val pixels = IntArray(width * height)
+            small.getPixels(pixels, 0, width, 0, 0, width, height)
+            PixelBlur.blur(pixels, width, height, RADIUS, 3)
+            small.setPixels(pixels, 0, width, 0, 0, width, height)
+            canvas.drawColor(Color.argb(TINT_ALPHA, Color.red(tint), Color.green(tint), Color.blue(tint)))
+            return small
+        } catch (e: Exception) {
+            Log.w(TAG, "could not blur background image", e)
+            return null
+        }
+    }
+}
