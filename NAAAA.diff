+<?xml version="1.0" encoding="utf-8"?>
+<!--
+    SPDX-License-Identifier: GPL-3.0-only
+    Modern outlined toolbar icon set: 24dp grid, 2dp round stroke. Drawn for this project in the
+    general style of common open line-icon sets; no third-party artwork is copied.
+    The stroke is white on purpose: it is tinted with the keyboard theme color at runtime.
+-->
+<vector xmlns:android="http://schemas.android.com/apk/res/android"
