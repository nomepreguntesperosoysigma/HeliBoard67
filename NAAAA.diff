@@ -0,0 +1,300 @@
+// SPDX-License-Identifier: GPL-3.0-only
+package helium314.keyboard.latin.voice
+
+import android.Manifest
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.os.Build
+import android.os.Bundle
+import android.os.Handler
+import android.os.Looper
+import android.speech.RecognitionListener
+import android.speech.RecognizerIntent
+import android.speech.SpeechRecognizer
+import android.view.Gravity
+import android.view.ViewGroup
+import android.widget.FrameLayout
+import androidx.annotation.StringRes
+import androidx.core.content.ContextCompat
+import helium314.keyboard.keyboard.KeyboardSwitcher
+import helium314.keyboard.latin.LatinIME
+import helium314.keyboard.latin.R
+import helium314.keyboard.latin.RichInputMethodManager
+import helium314.keyboard.latin.utils.Log
+import java.util.Locale
+
+/**
+ * Dictation inside the keyboard: shows a panel over the keyboard (animated bars, live text) and uses the
+ * speech recognition service of the device through [SpeechRecognizer], so the user is not sent to
+ * another voice input screen.
+ */
+class VoiceInputController(private val latinIME: LatinIME) {
+    private enum class State { OFF, IDLE, LISTENING }
+
+    private var state = State.OFF
+    private var stopRequested = false
+    private var recognizer: SpeechRecognizer? = null
+    private var view: VoiceInputView? = null
+    private var consecutiveBusyErrors = 0
+    private val handler = Handler(Looper.getMainLooper())
+
+    val isShowing get() = state != State.OFF
+
+    /**
+     * Opens or closes the voice panel.
+     * @return false if the built-in voice input can't be used, the caller should then use the old behavior
+     */
+    fun toggle(): Boolean {
+        if (isShowing) {
+            hide()
+            return true
+        }
+        if (!SpeechRecognizer.isRecognitionAvailable(latinIME)) return false
+        if (!hasPermission()) {
+            VoicePermissionActivity.start(latinIME)
+            return true
+        }
+        if (!show()) return false
+        startListening()
+        return true
+    }
+
+    fun hide() {
+        handler.removeCallbacksAndMessages(null)
+        destroyRecognizer()
+        view?.let { (it.parent as? ViewGroup)?.removeView(it) }
+        view = null
+        stopRequested = false
+        if (state != State.OFF) {
+            state = State.OFF
+            KeyboardSwitcher.getInstance().setVoicePanelShown(false)
+        }
+    }
+
+    private fun hasPermission() =
+        ContextCompat.checkSelfPermission(latinIME, Manifest.permission.RECORD_AUDIO) == PackageManager.PERMISSION_GRANTED
+
+    private fun show(): Boolean {
+        val switcher = KeyboardSwitcher.getInstance()
+        val root = switcher.inputViewRoot ?: return false
+        val panel = VoiceInputView(latinIME, object : VoiceInputView.Callback {
+            override fun onCloseClicked() = hide()
+            override fun onMicClicked() = onMicButton()
+        })
+        // the panel must have the height of the normal keyboard (suggestion strip + keys), not MATCH_PARENT:
+        // a match_parent child makes the input view as tall as the whole screen
+        val panelHeight = switcher.keyboardFrameHeight()
+        val blurActive = switcher.setVoicePanelShown(true)
+        panel.applyTheme(blurActive, switcher.blurredPanelBackground())
+        root.addView(panel, FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, panelHeight, Gravity.BOTTOM))
+        view = panel
+        state = State.IDLE
+        consecutiveBusyErrors = 0
+        return true
+    }
+
+    private fun onMicButton() {
+        when (state) {
+            State.LISTENING -> {
+                if (stopRequested) return
+                stopRequested = true
+                try {
+                    recognizer?.stopListening() // delivers what was said so far as a result
+                } catch (e: Exception) {
+                    Log.w(TAG, "stopListening failed", e)
+                    setIdle(R.string.voice_tap_to_speak)
+                    return
+                }
+                // safety net in case the recognition service never answers
+                handler.postDelayed({ if (state == State.LISTENING && stopRequested) setIdle(R.string.voice_tap_to_speak) }, STOP_TIMEOUT_MS)
+            }
+            State.IDLE -> {
+                if (!hasPermission()) {
+                    VoicePermissionActivity.start(latinIME)
+                    return
+                }
+                consecutiveBusyErrors = 0
+                startListening()
+            }
+            State.OFF -> {}
+        }
+    }
+
+    private fun createRecognizer(): SpeechRecognizer? {
+        var created: SpeechRecognizer? = null
+        try {
+            created = SpeechRecognizer.createSpeechRecognizer(latinIME)
+        } catch (e: Exception) {
+            Log.w(TAG, "could not create speech recognizer", e)
+        }
+        if (created == null) return null
+        created.setRecognitionListener(listener)
+        recognizer = created
+        return created
+    }
+
+    private fun destroyRecognizer() {
+        val current = recognizer ?: return
+        recognizer = null
+        try {
+            current.cancel()
+            current.destroy()
+        } catch (e: Exception) {
+            Log.w(TAG, "could not destroy speech recognizer", e)
+        }
+    }
+
+    private fun startListening() {
+        val panel = view ?: return
+        val rec = recognizer ?: createRecognizer()
+        if (rec == null) {
+            setIdle(R.string.voice_error_generic)
+            return
+        }
+        stopRequested = false
+        try {
+            rec.startListening(createRecognizerIntent())
+        } catch (e: Exception) {
+            Log.w(TAG, "startListening failed", e)
+            setIdle(R.string.voice_error_generic)
+            return
+        }
+        state = State.LISTENING
+        panel.setListening(true)
+        panel.setStatusText(latinIME.getString(R.string.voice_listening))
+    }
+
+    private fun setIdle(@StringRes message: Int) {
+        handler.removeCallbacksAndMessages(null)
+        stopRequested = false
+        if (state == State.OFF) return
+        state = State.IDLE
+        view?.setListening(false)
+        view?.setStatusText(latinIME.getString(message))
+    }
+
+    private fun createRecognizerIntent(): Intent {
+        val locale = recognitionLocale()
+        val intent = Intent(RecognizerIntent.ACTION_RECOGNIZE_SPEECH)
+        intent.putExtra(RecognizerIntent.EXTRA_LANGUAGE_MODEL, RecognizerIntent.LANGUAGE_MODEL_FREE_FORM)
+        intent.putExtra(RecognizerIntent.EXTRA_LANGUAGE, locale.toLanguageTag())
+        intent.putExtra(RecognizerIntent.EXTRA_CALLING_PACKAGE, latinIME.packageName)
+        intent.putExtra(RecognizerIntent.EXTRA_PARTIAL_RESULTS, true)
+        intent.putExtra(RecognizerIntent.EXTRA_MAX_RESULTS, 1)
+        // these are only hints, the recognition service may ignore them
+        intent.putExtra(RecognizerIntent.EXTRA_SPEECH_INPUT_COMPLETE_SILENCE_LENGTH_MILLIS, 1800L)
+        intent.putExtra(RecognizerIntent.EXTRA_SPEECH_INPUT_POSSIBLY_COMPLETE_SILENCE_LENGTH_MILLIS, 1500L)
+        // only spanish and english are accepted, the service may detect which of the two is spoken (Android 13+ / 14+)
+        val allowed = arrayListOf(spanishLocale().toLanguageTag(), englishLocale().toLanguageTag())
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+            intent.putExtra(RecognizerIntent.EXTRA_ENABLE_LANGUAGE_DETECTION, true)
+            intent.putStringArrayListExtra(RecognizerIntent.EXTRA_LANGUAGE_DETECTION_ALLOWED_LANGUAGES, allowed)
+        }
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.UPSIDE_DOWN_CAKE) {
+            intent.putExtra(RecognizerIntent.EXTRA_ENABLE_LANGUAGE_SWITCH, RecognizerIntent.LANGUAGE_SWITCH_BALANCED)
+            intent.putStringArrayListExtra(RecognizerIntent.EXTRA_LANGUAGE_SWITCH_ALLOWED_LANGUAGES, allowed)
+        }
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU && locale.language == "es")
+            intent.putStringArrayListExtra(RecognizerIntent.EXTRA_BIASING_STRINGS, ArrayList(SLANG_HINTS))
+        return intent
+    }
+
+    private fun spanishLocale(): Locale {
+        val system = Locale.getDefault()
+        return if (system.language == "es" && system.country.isNotEmpty()) system else Locale.forLanguageTag("es-AR")
+    }
+
+    private fun englishLocale(): Locale {
+        val system = Locale.getDefault()
+        return if (system.language == "en" && system.country.isNotEmpty()) system else Locale.US
+    }
+
+    /** only spanish or english: english if the keyboard layout is english, spanish for everything else */
+    private fun recognitionLocale(): Locale =
+        if (RichInputMethodManager.getInstance().currentSubtypeLocale.language == "en") englishLocale() else spanishLocale()
+
+    private val listener = object : RecognitionListener {
+        override fun onReadyForSpeech(params: Bundle?) {}
+
+        override fun onBeginningOfSpeech() {}
+
+        override fun onRmsChanged(rmsdB: Float) {
+            if (state == State.LISTENING) view?.setLevel(rmsdB)
+        }
+
+        override fun onBufferReceived(buffer: ByteArray?) {}
+
+        override fun onEndOfSpeech() {}
+
+        override fun onPartialResults(partialResults: Bundle?) {
+            if (state != State.LISTENING) return
+            val partial = firstResult(partialResults) ?: return
+            view?.setStatusText(partial)
+        }
+
+        override fun onResults(results: Bundle?) {
+            if (state != State.LISTENING) return
+            val text = firstResult(results)
+            if (text.isNullOrEmpty()) {
+                setIdle(R.string.voice_tap_to_speak)
+                return
+            }
+            latinIME.commitDictatedText(text)
+            if (stopRequested) {
+                setIdle(R.string.voice_tap_to_speak)
+                return
+            }
+            // keep dictating until the user stops
+            view?.setStatusText(latinIME.getString(R.string.voice_listening))
+            handler.postDelayed({ if (state == State.LISTENING && !stopRequested) startListening() }, RESTART_DELAY_MS)
+        }
+
+        override fun onError(error: Int) {
+            if (state != State.LISTENING) return
+            if (stopRequested) {
+                setIdle(R.string.voice_tap_to_speak)
+                return
+            }
+            when (error) {
+                SpeechRecognizer.ERROR_NO_MATCH, SpeechRecognizer.ERROR_SPEECH_TIMEOUT ->
+                    setIdle(R.string.voice_tap_to_speak)
+                SpeechRecognizer.ERROR_RECOGNIZER_BUSY -> {
+                    destroyRecognizer()
+                    if (++consecutiveBusyErrors <= 2) {
+                        handler.postDelayed({ if (state == State.LISTENING) startListening() }, BUSY_RETRY_DELAY_MS)
+                    } else {
+                        setIdle(R.string.voice_error_busy)
+                    }
+                }
+                SpeechRecognizer.ERROR_INSUFFICIENT_PERMISSIONS -> {
+                    setIdle(R.string.voice_permission_needed)
+                    VoicePermissionActivity.start(latinIME)
+                }
+                SpeechRecognizer.ERROR_NETWORK, SpeechRecognizer.ERROR_NETWORK_TIMEOUT, SpeechRecognizer.ERROR_SERVER ->
+                    setIdle(R.string.voice_error_network)
+                else -> {
+                    Log.w(TAG, "speech recognition error $error")
+                    setIdle(R.string.voice_error_generic)
+                }
+            }
+        }
+
+        override fun onEvent(eventType: Int, params: Bundle?) {}
+    }
+
+    private fun firstResult(bundle: Bundle?): String? =
+        bundle?.getStringArrayList(SpeechRecognizer.RESULTS_RECOGNITION)?.firstOrNull()?.trim()?.takeIf { it.isNotEmpty() }
+
+    companion object {
+        private val TAG = VoiceInputController::class.java.simpleName
+        private const val RESTART_DELAY_MS = 250L
+        private const val BUSY_RETRY_DELAY_MS = 400L
+        private const val STOP_TIMEOUT_MS = 4000L
+
+        // hints for the recognizer (Android 13+), spanish slang and current expressions
+        private val SLANG_HINTS = listOf(
+            "che", "boludo", "re bien", "posta", "bondi", "pibe", "mate", "meme", "memes", "brainrot", "skibidi",
+            "sigma", "mewing", "rizz", "crack", "capo", "basado", "random", "cringe", "bro", "gg", "wasap",
+        )
+    }
+}
