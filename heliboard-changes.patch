+// SPDX-License-Identifier: GPL-3.0-only
+package helium314.keyboard.latin.utils
+
+/**
+ * Box blur on ARGB pixels. Repeated a few times it looks like a gaussian blur.
+ * Edge pixels are repeated, so the borders don't get darker. Has no Android dependencies.
+ */
+object PixelBlur {
+    /** blurs [pixels] (row by row, [width] x [height]) in place */
+    fun blur(pixels: IntArray, width: Int, height: Int, radius: Int, passes: Int = 3) {
+        if (radius < 1 || width < 1 || height < 1 || pixels.size < width * height) return
+        val temp = IntArray(width * height)
+        repeat(passes) {
+            blurLines(pixels, temp, width, height, radius, true)
+            blurLines(temp, pixels, width, height, radius, false)
+        }
+    }
+
+    private fun blurLines(src: IntArray, dst: IntArray, width: Int, height: Int, radius: Int, horizontal: Boolean) {
+        val length = if (horizontal) width else height
+        val lines = if (horizontal) height else width
+        val step = if (horizontal) 1 else width // distance between neighbours along a line
+        val window = 2 * radius + 1
+        for (line in 0 until lines) {
+            val base = if (horizontal) line * width else line
+            var a = 0
+            var r = 0
+            var g = 0
+            var b = 0
+            for (i in -radius..radius) {
+                val p = src[base + i.coerceIn(0, length - 1) * step]
+                a += p ushr 24
+                r += (p shr 16) and 0xff
+                g += (p shr 8) and 0xff
+                b += p and 0xff
+            }
+            for (i in 0 until length) {
+                dst[base + i * step] = ((a / window) shl 24) or ((r / window) shl 16) or ((g / window) shl 8) or (b / window)
+                val outPixel = src[base + (i - radius).coerceIn(0, length - 1) * step]
+                val inPixel = src[base + (i + radius + 1).coerceIn(0, length - 1) * step]
+                a += (inPixel ushr 24) - (outPixel ushr 24)
+                r += ((inPixel shr 16) and 0xff) - ((outPixel shr 16) and 0xff)
+                g += ((inPixel shr 8) and 0xff) - ((outPixel shr 8) and 0xff)
+                b += (inPixel and 0xff) - (outPixel and 0xff)
+            }
+        }
+    }
+}
