+// SPDX-License-Identifier: GPL-3.0-only
+package helium314.keyboard.latin.voice
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Paint
+import android.graphics.RectF
+import android.view.View
+import kotlin.math.exp
+import kotlin.math.sin
+
+/**
+ * Animated "voice bars". Reacts to the microphone level while listening and breathes slowly while idle.
+ * Driven by the display frame callback (not by ValueAnimator), so it keeps moving even if the user
+ * has turned off system animations.
+ */
+class VoiceWaveView(context: Context) : View(context) {
+    private val paint = Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.FILL }
+    private val rect = RectF()
+    private var level = 0f // smoothed, 0..1
+    private var targetLevel = 0f
+    private var phase = 0f
+    private var listening = false
+    private var lastFrameNanos = 0L
+    private var running = false
+
+    private val ticker = object : Runnable {
+        override fun run() {
+            if (!running) return
+            advance()
+            invalidate()
+            postOnAnimation(this)
+        }
+    }
+
+    fun setColor(color: Int) {
+        paint.color = color
+        invalidate()
+    }
+
+    fun setListening(on: Boolean) {
+        listening = on
+        if (!on) targetLevel = 0f
+    }
+
+    /** level between 0 and 1 */
+    fun setLevel(newLevel: Float) {
+        targetLevel = newLevel.coerceIn(0f, 1f)
+    }
+
+    override fun onAttachedToWindow() {
+        super.onAttachedToWindow()
+        running = true
+        lastFrameNanos = 0L
+        postOnAnimation(ticker)
+    }
+
+    override fun onDetachedFromWindow() {
+        running = false
+        removeCallbacks(ticker)
+        super.onDetachedFromWindow()
+    }
+
+    private fun advance() {
+        val now = System.nanoTime()
+        val dt = if (lastFrameNanos == 0L) 0.016f else ((now - lastFrameNanos) / 1_000_000_000f).coerceAtMost(0.05f)
+        lastFrameNanos = now
+        val target = if (listening) targetLevel else 0f
+        val speed = if (target > level) 18f else 5f // quick to rise, slow to fall
+        level += (target - level) * (1f - exp(-speed * dt))
+        phase += dt * if (listening) 7f else 1.6f
+    }
+
+    override fun onDraw(canvas: Canvas) {
+        val w = width.toFloat()
+        val h = height.toFloat()
+        if (w <= 0f || h <= 0f) return
+        val slot = w / BAR_COUNT
+        val barWidth = slot * 0.52f
+        val minHeight = barWidth
+        val half = (BAR_COUNT - 1) / 2f
+        val amplitude = if (listening) 0.12f + level * 0.88f else 0.10f
+        for (i in 0 until BAR_COUNT) {
+            val x = i * slot + slot / 2f
+            val pos = (i - half) / half // -1..1
+            val envelope = 1f - 0.65f * pos * pos // taller in the middle
+            val wobble = 0.5f + 0.5f * sin(phase + i * 0.62f)
+            val barHeight = (minHeight + (h - minHeight) * envelope * amplitude * (0.35f + 0.65f * wobble))
+                .coerceIn(minHeight, h)
+            rect.set(x - barWidth / 2f, (h - barHeight) / 2f, x + barWidth / 2f, (h + barHeight) / 2f)
+            canvas.drawRoundRect(rect, barWidth / 2f, barWidth / 2f, paint)
+        }
+    }
+
+    companion object {
+        private const val BAR_COUNT = 29
+    }
+}
